# Docker ignore file for TestRIG

# Output directories
two_phase_output/
two_phase_example/
batch_traces/
batch_elfs/
batch_results/
output/
*.rvfi
*.elf

# Build artifacts
*.o
*.a
*.so
*.pyc
__pycache__/
.pytest_cache/

# Host-side Haskell build artifacts — cabal stores pre-linked objects
# here that WILL override a freshly-edited Main.hs if we let them into
# the image. Force a clean cabal build inside hs-builder by excluding.
vengines/QuickCheckVEngine/dist-newstyle/
vengines/QuickCheckVEngine/dist/
vengines/QuickCheckVEngine/.stack-work/
vengines/QuickCheckVEngine/bin/

# Git
.git/
.gitignore
.gitmodules

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
run.log

# VCS builds
vcs_testrig_out/
simv
csrc/

# Temporary files
*.tmp
*.bak
